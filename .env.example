# ============================================================
# Environment Configuration — copy to .env and fill in values
# ============================================================

# ---- LiveKit Server (self-hosted) --------------------------
LIVEKIT_API_KEY=APInKAhvt3yFR9G
LIVEKIT_API_SECRET=aBc1dEf2gHi3jKl4mNo5pQr6sTu7vWx8yZ90ABCD
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# ---- Backend -----------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./voiceops.db
INTERNAL_API_KEY=change-me-internal-secret-key-32chars
OPERATOR_API_KEY=change-me-operator-secret-key-32c

# ---- AI Providers (get free-tier keys) --------------------
# Deepgram STT — https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key

# Groq LLM (fast inference) — https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Deepgram TTS (or swap for ElevenLabs/Cartesia)
# TTS uses the same DEEPGRAM_API_KEY above

# OpenAI (for compliance LLM check only) — https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key

# ---- Agent Worker ------------------------------------------
AGENT_NAME=support-agent
BACKEND_URL=http://localhost:8000
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=${GROQ_API_KEY}
LLM_MODEL=llama-3.3-70b-versatile
STT_MODEL=nova-3
TTS_VOICE=aura-2-thalia-en

# ---- Frontend (Next.js) -----------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
